#!/usr/bin/env python3
"""Build a STITCH++ JavaScript harness inside the project image.

Snapshots harness/ into <out>/app (campaigns run from their own copy), checks that it loads,
and writes
  <out>/fuzzer          the engine, with the Node.js worker as its runtime
  <out>/repro           runs .stp programs
  <out>/manifest.json   the stubs as the fuzzer sees them
stitch.toml [javascript]: include = ["pkg", ...] (packages to instrument; default: everything
                          outside the runtime), node_options = ["--max-old-space-size=4096"]
"""
import argparse
import json
import shlex
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

RUNTIME = "/stitch/javascript/node_modules/stitch/main.js"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project", default="/project")
    ap.add_argument("--out", default=None)
    ap.add_argument("--target", default="all")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    proj = Path(a.project).resolve()
    cfg = tomllib.loads((proj / "stitch.toml").read_text()) if (proj / "stitch.toml").exists() else {}
    js = cfg.get("javascript", {})
    out = Path(a.out) if a.out else proj / ".stitch" / "build"
    if not out.is_absolute():
        out = proj / out
    out.mkdir(parents=True, exist_ok=True)
    app = out / "app"
    shutil.rmtree(app, ignore_errors=True)
    if not (proj / "harness").is_dir():
        return finish(a, {"ok": False, "errors": [{"file": "harness", "output": "no harness/ directory"}]})
    shutil.copytree(proj / "harness", app / "harness", ignore=shutil.ignore_patterns("data"), symlinks=True)
    node = "node " + " ".join(shlex.quote(o) for o in js.get("node_options", ["--max-old-space-size=4096"]))
    head = ["#!/bin/sh", 'HERE="$(cd "$(dirname "$0")" && pwd)"',
            f"export STITCH_JS_INCLUDE={shlex.quote(','.join(js.get('include', [])))}",
            'export STITCH_PROJECT="$HERE/app"']
    (out / "fuzzer").write_text("\n".join(head + [
        f'export STITCH_WORKER="{node} {RUNTIME} worker --project \'$HERE/app\'"',
        'exec /stitch/bin/stitch-engine "$@"', ""]))
    (out / "repro").write_text("\n".join(head + [f'exec {node} {RUNTIME} --project "$HERE/app" "$@"', ""]))
    for f in ("fuzzer", "repro"):
        (out / f).chmod(0o755)
    r = subprocess.run([str(out / "repro"), "--manifest"], capture_output=True, text=True, cwd=proj)
    if r.returncode != 0 or not r.stdout.strip():
        return finish(a, {"ok": False, "errors": [{"file": "harness", "output": (r.stderr or r.stdout)[-8000:]}]})
    m = json.loads(r.stdout.strip().splitlines()[-1])
    (out / "manifest.json").write_text(json.dumps(m))
    return finish(a, {"ok": True, "endpoints": len(m["endpoints"]), "objects": len(m["objects"]),
                      "datatypes": len(m["datatypes"]), "errors": []})


def finish(a, res):
    if a.json:
        print(json.dumps(res))
    elif res["ok"]:
        print(f"built: {res['endpoints']} endpoints, {res['objects']} object types, {res['datatypes']} datatypes")
    else:
        for e in res["errors"]:
            sys.stderr.write(e["output"] + "\n")
    sys.exit(0 if res["ok"] else 1)


if __name__ == "__main__":
    main()
