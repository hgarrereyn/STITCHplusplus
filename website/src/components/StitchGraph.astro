---
// Programs the fuzzer could build from the home page harness: random, valid (every input gets an
// object of its type that is still available), drawn with the same shapes as the harness gutter.
---

<figure class="stitch-graph">
  <svg viewBox="0 0 360 404" role="img" aria-label="An example program built from the endpoints"></svg>
  <figcaption class="legend">
    <span><i class="dot p-store"></i>Store</span>
    <span><i class="dot p-snap"></i>Snapshot</span>
    <span><i class="diamond"></i>fuzzed value</span>
    <span><i class="dot hollow"></i>taken</span>
  </figcaption>
</figure>

<script>
  import { currentLang, onLang } from "./lang-state";
  import { nameOf } from "./showcase";
  import { randomProgram, renderProgram, type Call } from "./program";

  const W = 360, H = 404;
  for (const fig of document.querySelectorAll<HTMLElement>(".stitch-graph")) {
    const svg = fig.querySelector("svg")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let program: Call[] = randomProgram();

    const draw = (enter: boolean) => {
      const { svg: body, height } = renderProgram(program, (id) => nameOf(currentLang(), id), { values: true, width: W });
      const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
      g.setAttribute("class", `program${enter && !reduced ? " entering" : ""}`);
      g.setAttribute("transform", `translate(0 ${Math.max(0, (H - height) / 2)})`);
      g.innerHTML = body;
      for (const old of [...svg.children]) {
        old.classList.add("leaving");
        setTimeout(() => old.remove(), reduced ? 0 : 350);
      }
      svg.append(g);
      if (enter && !reduced) requestAnimationFrame(() => requestAnimationFrame(() => g.classList.remove("entering")));
    };

    draw(false);
    onLang(() => draw(false));
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(fig);
    setInterval(() => {
      if (!visible || document.hidden) return;
      program = randomProgram();
      draw(true);
    }, reduced ? 5000 : 3200);
  }
</script>
