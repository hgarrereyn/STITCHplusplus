---
// The tutorial harness in the reader's language, with notes on hover, focus or tap.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import RunOutput from "./RunOutput.astro";
import { HARNESS_NOTES } from "./harness-notes";

// Every note must point at text in its harness.
for (const [lang, notes] of Object.entries(HARNESS_NOTES)) {
  const harness = readFileSync(join(process.cwd(), "src/tutorial-output", lang, "harness.txt"), "utf8");
  for (const { at } of notes) {
    if (!harness.split("\n").some((line) => line.includes(at))) {
      throw new Error(`harness-notes: "${at}" is not on one line of ${lang}/harness.txt`);
    }
  }
}
---

<div class="harness-notes">
  <RunOutput name="harness" lang="source" />
  <div class="note-pop" role="tooltip" id="harness-note" hidden></div>
</div>

<script type="application/json" id="harness-notes-data" set:html={JSON.stringify(HARNESS_NOTES)} />

<script>
  type Note = { at: string; note: string };
  const data: Record<string, Note[]> = JSON.parse(document.getElementById("harness-notes-data")!.textContent!);
  const root = document.querySelector<HTMLElement>(".harness-notes");
  const pop = root?.querySelector<HTMLElement>(".note-pop");

  // Wrap the first occurrence of `at` inside one code line, across highlighting spans.
  function mark(line: Element, at: string, note: string) {
    const nodes: Text[] = [];
    const walker = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    const text = nodes.map((n) => n.data).join("");
    const start = text.indexOf(at);
    if (start < 0) return false;
    const end = start + at.length;
    const range = document.createRange();
    let pos = 0;
    for (const n of nodes) {
      const next = pos + n.data.length;
      if (start >= pos && start < next) range.setStart(n, start - pos);
      if (end > pos && end <= next) range.setEnd(n, end - pos);
      pos = next;
    }
    const m = document.createElement("span");
    m.className = "note-mark";
    m.tabIndex = 0;
    m.dataset.note = note;
    m.setAttribute("aria-describedby", "harness-note");
    m.append(range.extractContents());
    range.insertNode(m);
    return true;
  }

  if (root && pop) {
    for (const block of root.querySelectorAll<HTMLElement>(".lang-block")) {
      const notes = data[block.dataset.for!] ?? [];
      const lines = [...block.querySelectorAll(".ec-line")];
      for (const { at, note } of notes) lines.some((line) => mark(line, at, note));
    }

    let active: HTMLElement | null = null;
    const show = (m: HTMLElement) => {
      active = m;
      pop.textContent = m.dataset.note!;
      pop.hidden = false;
      const r = m.getBoundingClientRect(), box = root.getBoundingClientRect();
      const left = Math.min(Math.max(r.left - box.left, 0), box.width - pop.offsetWidth);
      pop.style.left = `${left}px`;
      pop.style.top = `${r.bottom - box.top + 8}px`;
    };
    const hide = () => { active = null; pop.hidden = true; };
    root.addEventListener("mouseover", (e) => {
      const m = (e.target as HTMLElement).closest<HTMLElement>(".note-mark");
      if (m) show(m);
    });
    root.addEventListener("mouseout", (e) => {
      if ((e.target as HTMLElement).closest(".note-mark") && !(e.relatedTarget as HTMLElement | null)?.closest?.(".note-mark")) hide();
    });
    root.addEventListener("focusin", (e) => {
      const m = (e.target as HTMLElement).closest<HTMLElement>(".note-mark");
      if (m) show(m);
    });
    root.addEventListener("focusout", hide);
    root.addEventListener("click", (e) => {   // touch: tap a mark to show its note, tap again to hide
      const m = (e.target as HTMLElement).closest<HTMLElement>(".note-mark");
      if (m && m === active && pop.hidden === false && (e as PointerEvent).pointerType === "touch") hide();
      else if (m) show(m);
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") hide(); });
    document.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest(".note-mark")) hide(); });
  }
</script>
