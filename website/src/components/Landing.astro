---
// Home page body: the language picker, the tutorial harness (with a guided tour) next to how the fuzzer
// stitches its stubs and the crash it finds (recorded from the tutorial run), the guides, install.
import { Code } from "@astrojs/starlight/components";
import RunOutput from "./RunOutput.astro";
import LangButtons from "./LangButtons.astro";
import HarnessTour from "./HarnessTour.astro";
import StitchGraph from "./StitchGraph.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;
---

<div class="landing not-content">
  <section class="showcase-wrap" aria-label="A harness, the programs made from it, and a crash it found">
    <LangButtons />
    <div class="showcase">
      <div class="pane">
        <p class="pane-label">You write a spec</p>
        <HarnessTour />
      </div>
      <div class="pane">
        <p class="pane-label">STITCH++ stitches its endpoints into programs</p>
        <StitchGraph />
        <p class="pane-label">and finds one that breaks</p>
        <RunOutput name="trace-short" />
      </div>
    </div>
  </section>

  <section class="guides" aria-label="Guides">
    <a class="guide" href={url("guide/")}>
      <span class="guide-kicker">For humans</span>
      <span class="guide-title">Tutorial and concepts</span>
      <span class="guide-text">Fuzz a small key-value store step by step, in the language you pick.</span>
    </a>
    <a class="guide" href={url("agents/overview.md")}>
      <span class="guide-kicker">For agents</span>
      <span class="guide-title">overview.md</span>
      <span class="guide-text">A plain-text guide: the workflow, the rules for good stubs, and a file per language.</span>
    </a>
  </section>

  <section class="row" aria-label="Install">
    <h2 class="row-title">Install</h2>
    <Code code={"pip install stitch-fuzz\nstitch setup --lang python"} lang="sh" frame="none" />
    <p class="row-note">Requires Docker. The library, the harness and the fuzzer run in containers.</p>
  </section>
</div>
