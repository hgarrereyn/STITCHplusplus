---
// Home page body: a harness next to the program it produced, the two guides, languages, install.
import { Code } from "@astrojs/starlight/components";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;

const stubs = `@stitch.endpoint(bails_on=(ValueError,))
def load(text: Str[256, KvText]) -> New[Store]:
    return kvlib.load(text)

@stitch.endpoint(bails_on=(ValueError,))
def put(st: Borrow[Store], key: Str[16], value: Str[32]):
    st.put(key, value)

@stitch.endpoint
def remove(st: Borrow[Store], key: Str[16]):
    st.remove(key)

@stitch.endpoint
def roundtrip(st: Borrow[Store]):
    again = kvlib.load(st.dump())
    stitch.check(dict(again.items()) == dict(st.items()),
                 "dump/load roundtrip")`;

const trace = `[stitch] #0 load(text=Str[0,decoded]"")
[stitch]     -> ok produced o0.0
[stitch] #1 put(st=o0.0, key=Str[3]"tmp", value=Str[0]"")
[stitch]     -> ok
[stitch] #2 remove(st=o0.0, key=Str[3]"tmp")
[stitch]     -> ok
[stitch] #3 roundtrip(st=o0.0)

[stitch] EXCEPTION in roundtrip: KeyError: 'tmp'
    #0 0x0 in Store.items /opt/venv/lib/python3.12/site-packages/kvlib/__init__.py:26
    #1 0x0 in Store.dump /opt/venv/lib/python3.12/site-packages/kvlib/__init__.py:29`;

const languages = [
  ["cpp", "C/C++"],
  ["python", "Python"],
  ["javascript", "JavaScript"],
  ["java", "Java"],
  ["go", "Go"],
  ["rust", "Rust"],
  ["ruby", "Ruby"],
  ["swift", "Swift"],
  ["objc", "Objective-C"],
];
---

<div class="landing not-content">
  <section class="showcase" aria-label="A harness and a crash it found">
    <div class="pane">
      <p class="pane-label">You write stubs</p>
      <Code code={stubs} lang="python" title="harness/stubs.py" frame="code" />
    </div>
    <div class="pane">
      <p class="pane-label">STITCH++ finds a program that breaks it</p>
      <Code code={trace} lang="text" title="stitch exec c5 --trace" frame="terminal" />
    </div>
  </section>

  <section class="guides" aria-label="Guides">
    <a class="guide" href={url("guide/")}>
      <span class="guide-kicker">For humans</span>
      <span class="guide-title">Tutorial and concepts</span>
      <span class="guide-text">Fuzz a small key-value store step by step, in the language you pick.</span>
    </a>
    <a class="guide" href={url("agents/")}>
      <span class="guide-kicker">For agents</span>
      <span class="guide-title">Workflow and rules</span>
      <span class="guide-text">A checklist, the rules for good stubs, and how to triage crashes.</span>
    </a>
  </section>

  <section class="row" aria-label="Languages">
    <h2 class="row-title">Languages</h2>
    <ul class="langs">
      {languages.map(([id, name]) => (
        <li><a href={url(`reference/languages/${id}/`)}>{name}</a></li>
      ))}
    </ul>
  </section>

  <section class="row" aria-label="Install">
    <h2 class="row-title">Install</h2>
    <Code code={"pip install stitch-fuzz\nstitch setup --lang python"} lang="sh" frame="none" />
    <p class="row-note">Requires Docker. The library, the harness and the fuzzer run in containers.</p>
  </section>
</div>
