---
// The tutorial harness in the reader's language, with a step-by-step tour for first-time readers.
// Steps and their targets are in harness-tour.ts.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import RunOutput from "./RunOutput.astro";
import { HARNESS_TOUR, type Range } from "./harness-tour";

// Every anchor must be in its harness.
const rangeOk = (lines: string[], [from, , to]: Range) => {
  const i = lines.findIndex((l) => l.includes(from));
  const hit = (l: string) => (to.startsWith("=") ? l === to.slice(1) : l.includes(to));
  return i >= 0 && lines.slice(i).some(hit);
};
for (const [lang, steps] of Object.entries(HARNESS_TOUR)) {
  const lines = readFileSync(join(process.cwd(), "src/tutorial-output", lang, "harness.txt"), "utf8").split("\n");
  for (const step of steps) {
    for (const r of step.ranges ?? []) if (!rangeOk(lines, r)) throw new Error(`harness-tour ${lang}: range ${JSON.stringify(r)} not found`);
    for (const m of step.marks ?? []) if (!lines.some((l) => l.includes(m))) throw new Error(`harness-tour ${lang}: "${m}" not found`);
  }
}
const count = HARNESS_TOUR.python.length;
---

<div class="tour">
  <div class="tour-panel">
    <div class="tour-head">
      <span class="tour-count"><span class="tour-n">1</span> / {count}</span>
      <strong class="tour-title"></strong>
    </div>
    <p class="tour-text" aria-live="polite"></p>
    <div class="tour-nav">
      <button type="button" class="tour-prev" aria-label="Previous step">‹ Back</button>
      <span class="tour-dots">
        {Array.from({ length: count }, (_, i) => <button type="button" class="tour-dot" aria-label={`Step ${i + 1}`} data-i={i} />)}
      </span>
      <button type="button" class="tour-next" aria-label="Next step">Next ›</button>
    </div>
  </div>
  <div class="tour-code">
    <RunOutput name="harness" lang="source" wrap />
    <div class="note-pop" role="tooltip" hidden></div>
  </div>
</div>

<script type="application/json" id="harness-tour-data" set:html={JSON.stringify(HARNESS_TOUR)} />

<script>
  import { currentLang, onLang } from "./lang-state";

  type Range = [string, number, string, number?];
  type Step = { title: string; text: string; ranges?: Range[]; marks?: string[] };
  const DATA: Record<string, Step[]> = JSON.parse(document.getElementById("harness-tour-data")!.textContent!);

  const tour = document.querySelector<HTMLElement>(".tour");
  if (tour) {
    const $ = <T extends Element>(s: string) => tour.querySelector<T>(s)!;
    const title = $<HTMLElement>(".tour-title"), text = $<HTMLElement>(".tour-text"), n = $<HTMLElement>(".tour-n");
    const prev = $<HTMLButtonElement>(".tour-prev"), next = $<HTMLButtonElement>(".tour-next");
    const dots = [...tour.querySelectorAll<HTMLButtonElement>(".tour-dot")];
    const pop = $<HTMLElement>(".note-pop"), code = $<HTMLElement>(".tour-code");
    let step = 0;

    // Wrap every occurrence of `at` in a line, last first so earlier offsets stay valid.
    function wrapAll(line: Element, at: string, i: number) {
      const textOf = () => {
        const nodes: Text[] = [];
        const w = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
        while (w.nextNode()) nodes.push(w.currentNode as Text);
        return nodes;
      };
      const full = textOf().map((t) => t.data).join("");
      const starts: number[] = [];
      for (let p = full.indexOf(at); p >= 0; p = full.indexOf(at, p + at.length)) starts.push(p);
      for (const start of starts.reverse()) {
        const nodes = textOf(), end = start + at.length, range = document.createRange();
        let pos = 0;
        for (const t of nodes) {
          const nxt = pos + t.data.length;
          if (start >= pos && start < nxt) range.setStart(t, start - pos);
          if (end > pos && end <= nxt) range.setEnd(t, end - pos);
          pos = nxt;
        }
        const m = document.createElement("span");
        m.className = "tour-mark";
        m.tabIndex = 0;
        m.setAttribute("role", "button");
        m.dataset.step = String(i);
        m.append(range.extractContents());
        range.insertNode(m);
      }
    }

    // Lines of each step, per language block.
    const stepLines = new Map<string, Element[][]>();
    for (const block of tour.querySelectorAll<HTMLElement>(".lang-block")) {
      const lang = block.dataset.for!, steps = DATA[lang] ?? [];
      const lines = [...block.querySelectorAll(".ec-line")];
      const texts = lines.map((l) => l.textContent ?? "");
      const perStep: Element[][] = steps.map(() => []);
      steps.forEach((s, i) => {
        for (const [from, before, to, after = 0] of s.ranges ?? []) {
          const a = texts.findIndex((t) => t.includes(from));
          const hit = (t: string) => (to.startsWith("=") ? t === to.slice(1) : t.includes(to));
          const b = texts.findIndex((t, k) => k >= a && hit(t));
          if (a >= 0 && b >= 0) perStep[i].push(...lines.slice(Math.max(0, a - before), b + after + 1));
        }
        for (const at of s.marks ?? []) {
          lines.forEach((line, k) => {
            if (texts[k].includes(at)) {
              wrapAll(line, at, i);
              perStep[i].push(line);
            }
          });
        }
      });
      stepLines.set(lang, perStep);
    }

    function show(i: number, scroll = false) {
      const lang = currentLang(), steps = DATA[lang] ?? DATA.python;
      step = Math.max(0, Math.min(steps.length - 1, i));
      const s = steps[step];
      title.textContent = s.title;
      text.textContent = s.text;
      n.textContent = String(step + 1);
      prev.disabled = step === 0;
      next.disabled = step === steps.length - 1;
      dots.forEach((d, k) => d.setAttribute("aria-current", String(k === step)));
      tour.querySelectorAll(".tour-on").forEach((e) => e.classList.remove("tour-on"));
      const lines = stepLines.get(lang)?.[step] ?? [];
      code.classList.toggle("tour-dim", lines.length > 0);
      code.classList.toggle("tour-all", lines.length === 0);
      lines.forEach((l) => l.classList.add("tour-on"));
      tour.querySelectorAll(`.lang-block[data-for="${lang}"] .tour-mark[data-step="${step}"]`).forEach((m) => m.classList.add("tour-on"));
      // Bring the step's first highlight into view sideways (long lines scroll inside the code block).
      const pre = tour.querySelector<HTMLElement>(`.lang-block[data-for="${lang}"] pre`);
      if (pre) {
        const first = pre.querySelector<HTMLElement>(`.tour-mark[data-step="${step}"]`);
        const left = first ? first.getBoundingClientRect().left - pre.getBoundingClientRect().left + pre.scrollLeft - 16 : 0;
        if (!first || left < pre.scrollLeft || left + first.offsetWidth > pre.scrollLeft + pre.clientWidth) {
          pre.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
        }
      }
      if (scroll && lines[0]) {
        const r = lines[0].getBoundingClientRect();
        const panel = $<HTMLElement>(".tour-panel").getBoundingClientRect();
        if (r.top < panel.bottom + 8 || r.bottom > innerHeight - 16) {
          scrollBy({ top: r.top - panel.bottom - 24, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        }
      }
    }

    prev.addEventListener("click", () => show(step - 1, true));
    next.addEventListener("click", () => show(step + 1, true));
    dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.i), true)));

    // A highlighted phrase opens its step: tap, click, Enter or Space.
    const open = (m: HTMLElement) => {
      pop.hidden = true;
      show(Number(m.dataset.step));
      $<HTMLElement>(".tour-panel").scrollIntoView({ block: "nearest" });
    };
    tour.addEventListener("click", (e) => {
      const m = (e.target as HTMLElement).closest<HTMLElement>(".tour-mark");
      if (m) open(m);
    });
    tour.addEventListener("keydown", (e) => {
      const m = (e.target as HTMLElement).closest<HTMLElement>(".tour-mark");
      if (m && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); open(m); }
    });

    // With a mouse, hovering a phrase previews its step.
    tour.addEventListener("pointerover", (e) => {
      if (e.pointerType !== "mouse") return;
      const m = (e.target as HTMLElement).closest<HTMLElement>(".tour-mark");
      if (!m) return;
      const s = (DATA[currentLang()] ?? DATA.python)[Number(m.dataset.step)];
      pop.textContent = `${s.title}. Click to read more.`;
      pop.hidden = false;
      const r = m.getBoundingClientRect(), box = code.getBoundingClientRect();
      pop.style.left = `${Math.min(Math.max(r.left - box.left, 0), box.width - pop.offsetWidth)}px`;
      pop.style.top = `${r.bottom - box.top + 6}px`;
    });
    tour.addEventListener("pointerout", (e) => {
      if ((e.target as HTMLElement).closest(".tour-mark")) pop.hidden = true;
    });

    show(0);
    onLang(() => show(step));
  }
</script>
